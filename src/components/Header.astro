---
// Header.astro - Barra de navegação fixa com blur e branding SaaSCore Sistemas / SGEMH
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo SaaSCore Sistemas & SGEMH -->
    <a href="#" class="group flex items-center gap-3 focus:outline-none focus:ring-2 focus:ring-cyan-400 rounded-lg p-1">
      <div class="relative flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl border border-cyan-500/30 bg-slate-950/90 shadow-lg shadow-cyan-500/20 transition-transform group-hover:scale-105 group-hover:border-cyan-400/50">
        <img
          src="/logo-icon.png"
          alt="SaaSCore Sistemas Logo"
          class="h-full w-full object-cover"
          width="44"
          height="44"
          loading="eager"
        />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-white">
            SaaSCore <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">SGEMH</span>
          </span>
          <span class="rounded bg-cyan-500/10 px-1.5 py-0.5 text-[10px] font-bold text-cyan-300 border border-cyan-500/20">Sistemas</span>
        </div>
        <span class="text-[9.5px] uppercase font-semibold tracking-wider text-slate-400 hidden sm:inline-block">
          Gerenciamento Eletrônico de Engenharia Clínica & Ativos
        </span>
      </div>
    </a>

    <!-- Links Âncora Desktop -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
      <a href="/#recursos" class="transition hover:text-cyan-400 focus:outline-none focus:text-cyan-400">Recursos</a>
      <a href="/#normas" class="transition hover:text-cyan-400 focus:outline-none focus:text-cyan-400">Normas & RDC</a>
      <a href="/#planos" class="transition hover:text-cyan-400 focus:outline-none focus:text-cyan-400">Planos</a>
      <a href="/#contato" class="transition hover:text-cyan-400 focus:outline-none focus:text-cyan-400">Contato</a>
      <a href="/gestao-global" class="inline-flex items-center gap-1.5 rounded-full border border-slate-700 bg-slate-900/90 px-3 py-1 text-xs font-semibold text-cyan-300 hover:border-cyan-500/50 hover:text-cyan-200 transition">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
        Gestão Global
      </a>
    </nav>

    <!-- Botão CTA Desktop -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="#contato"
        class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-cyan-500 to-cyan-400 px-5 py-2.5 text-sm font-semibold text-slate-950 shadow-md shadow-cyan-500/20 transition hover:from-cyan-400 hover:to-cyan-300 hover:shadow-cyan-500/30 focus:outline-none focus:ring-2 focus:ring-cyan-400 active:scale-95"
      >
        Agendar Demonstração
      </a>
    </div>

    <!-- Botão Mobile Menu Hamburger -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="flex md:hidden items-center justify-center rounded-lg p-2 text-slate-400 hover:bg-slate-900 hover:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"
      aria-label="Abrir menu principal"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Menu Mobile Desdobrável -->
  <div id="mobile-menu" class="hidden border-b border-slate-800 bg-slate-950/95 px-4 pt-2 pb-6 backdrop-blur-xl md:hidden">
    <div class="flex flex-col space-y-4 pt-2">
      <div class="pb-2 border-b border-slate-800 text-xs text-slate-400">
        <span class="font-bold text-white">SaaSCore Sistemas</span> • SGEMH
      </div>
      <a href="/#recursos" class="text-base font-medium text-slate-300 hover:text-cyan-400">Recursos</a>
      <a href="/#normas" class="text-base font-medium text-slate-300 hover:text-cyan-400">Normas & RDC</a>
      <a href="/#planos" class="text-base font-medium text-slate-300 hover:text-cyan-400">Planos</a>
      <a href="/#contato" class="text-base font-medium text-slate-300 hover:text-cyan-400">Contato</a>
      <a href="/gestao-global" class="text-base font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
        Gestão Global SaaS (Leads)
      </a>
      <a
        href="#contato"
        class="mt-2 inline-flex items-center justify-center rounded-lg bg-cyan-500 px-4 py-3 text-center text-sm font-semibold text-slate-950 shadow hover:bg-cyan-400"
      >
        Agendar Demonstração
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
