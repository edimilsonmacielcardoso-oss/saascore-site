---
// gestao-global.astro - Painel de Gestão Global SaaS para visualização e qualificação de leads
import Layout from '../layouts/Layout.astro';
import { getLeads } from '../lib/db';

export const prerender = false;

// Verificação de autenticação restrita à Gestão Global
const sessionCookie = Astro.cookies.get('saascore_session')?.value;
if (sessionCookie !== 'auth_edimilson_maciel') {
  return Astro.redirect('/login');
}

const initialLeads = await getLeads();
---

<Layout
  title="Gestão Global SaaS | SaaSCore Sistemas - Painel de Leads SGEMH"
  description="Painel administrativo de controle de leads, agendamentos e prospecção de parques hospitalares da SaaSCore Sistemas."
  noindex={true}
>
  <!-- Barra Superior Administrativa -->
  <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/90 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="relative flex h-9 w-9 items-center justify-center overflow-hidden rounded-lg border border-cyan-500/30 bg-slate-950/90 shadow-md shadow-cyan-500/20 transition-transform group-hover:scale-105 group-hover:border-cyan-400/50">
            <img
              src="/logo-icon.png"
              alt="SaaSCore Sistemas Logo"
              class="h-full w-full object-cover"
              width="36"
              height="36"
              loading="eager"
            />
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="text-base font-extrabold tracking-tight text-white">SaaSCore Sistemas</span>
              <span class="rounded bg-cyan-500/20 px-2 py-0.5 text-[10px] font-bold text-cyan-300 border border-cyan-500/30">
                Gestão Global SaaS
              </span>
            </div>
            <span class="text-[9px] uppercase tracking-wider text-slate-400">Pipeline de Leads • SGEMH</span>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-cyan-400 transition"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Voltar ao Portal SGEMH
        </a>
        <button
          id="btn-refresh"
          class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs font-medium text-slate-300 hover:border-cyan-500/50 hover:text-white transition flex items-center gap-1.5"
        >
          <svg class="h-3.5 w-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Atualizar
        </button>

        <!-- Usuário Autenticado e Botão Sair -->
        <div class="flex items-center gap-3 pl-3 border-l border-slate-800">
          <div class="hidden sm:flex flex-col text-right">
            <span class="text-xs font-bold text-white leading-tight">Edimilson Maciel Cardoso</span>
            <span class="text-[10px] text-slate-400">edimilsonmacielcardoso@gmail.com</span>
          </div>
          <a
            href="/logout"
            class="rounded-lg border border-slate-800 bg-slate-900/90 px-3 py-1.5 text-xs font-semibold text-rose-400 hover:border-rose-500/50 hover:bg-rose-500/10 transition flex items-center gap-1.5"
            title="Encerrar sessão administrativa"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Sair</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Conteúdo Principal do Painel -->
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- Topo da Seção de Métricas -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-slate-800">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
          Painel de Qualificação de Leads & Oportunidades
        </h1>
        <p class="mt-1 text-sm text-slate-400">
          Dados persistidos em Banco de Dados próprio (compatível com Supabase / PostgreSQL).
        </p>
      </div>

      <!-- Botões de Ação Global -->
      <div class="flex items-center gap-3">
        <button
          id="btn-export-csv"
          class="inline-flex items-center gap-2 rounded-lg bg-slate-900 border border-slate-800 px-4 py-2 text-xs font-semibold text-slate-200 hover:border-slate-700 hover:text-white transition"
        >
          <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Exportar CSV (Excel)
        </button>
        <button
          id="btn-toggle-sql"
          class="inline-flex items-center gap-2 rounded-lg bg-cyan-500/10 border border-cyan-500/30 px-4 py-2 text-xs font-semibold text-cyan-300 hover:bg-cyan-500/20 transition"
        >
          <svg class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
          Schema SQL Supabase
        </button>
      </div>
    </div>

    <!-- Cards de Métricas Rápidas -->
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 backdrop-blur-sm">
        <span class="text-xs font-medium text-slate-400">Total de Leads</span>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="metric-total" class="text-3xl font-extrabold text-white">0</span>
          <span class="text-xs text-cyan-400 font-semibold">cadastrados</span>
        </div>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 backdrop-blur-sm">
        <span class="text-xs font-medium text-slate-400">Novos (Aguardando Contato)</span>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="metric-novos" class="text-3xl font-extrabold text-cyan-400">0</span>
          <span class="text-xs text-slate-400">prioritários</span>
        </div>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 backdrop-blur-sm">
        <span class="text-xs font-medium text-slate-400">Demonstrações Agendadas</span>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="metric-agendados" class="text-3xl font-extrabold text-blue-400">0</span>
          <span class="text-xs text-slate-400">em negociação</span>
        </div>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 backdrop-blur-sm">
        <span class="text-xs font-medium text-slate-400">Grandes Hospitais (+500 ativos)</span>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="metric-enterprise" class="text-3xl font-extrabold text-emerald-400">0</span>
          <span class="text-xs text-slate-400">porte enterprise</span>
        </div>
      </div>
    </div>

    <!-- Seção Retrátil: Schema SQL do Banco Supabase / PostgreSQL -->
    <div id="sql-box" class="hidden mt-6 rounded-xl border border-cyan-500/30 bg-slate-900/90 p-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
          <h3 class="text-sm font-bold text-white">DDL / Script SQL para Supabase ou PostgreSQL</h3>
        </div>
        <button id="btn-copy-sql" class="text-xs text-cyan-400 hover:text-cyan-300 font-semibold underline">
          Copiar SQL
        </button>
      </div>
      <pre id="sql-code" class="mt-4 overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs font-mono text-cyan-300 leading-relaxed">
-- Tabela para Gestão Global SaaS de Leads SGEMH (SaaSCore Sistemas)
CREATE TABLE IF NOT EXISTS public.leads (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    institution VARCHAR(255) NOT NULL,
    park_size VARCHAR(50) NOT NULL,
    message TEXT,
    status VARCHAR(50) DEFAULT 'novo',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- Índices de consulta rápida
CREATE INDEX IF NOT EXISTS idx_leads_created_at ON public.leads(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_leads_status ON public.leads(status);
      </pre>
      <p class="mt-3 text-xs text-slate-400">
        * Se você conectar uma instância Supabase, basta colar o script acima no SQL Editor do Supabase para criar a tabela idêntica.
      </p>
    </div>

    <!-- Barra de Filtros e Busca -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 rounded-xl border border-slate-800 bg-slate-900/40 p-4">
      <div class="w-full sm:w-96 relative">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por hospital, nome ou e-mail..."
          class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-2 text-xs text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <button data-filter="all" class="filter-btn active rounded-lg bg-cyan-500 px-3 py-1.5 text-xs font-semibold text-slate-950">
          Todos
        </button>
        <button data-filter="novo" class="filter-btn rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300">
          Novos
        </button>
        <button data-filter="em_contato" class="filter-btn rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300">
          Em Contato
        </button>
        <button data-filter="agendado" class="filter-btn rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300">
          Agendados
        </button>
        <button data-filter="convertido" class="filter-btn rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300">
          Convertidos
        </button>
      </div>
    </div>

    <!-- Tabela de Leads -->
    <div class="mt-6 overflow-hidden rounded-xl border border-slate-800 bg-slate-900/30">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-slate-800 bg-slate-900/80 text-slate-400 uppercase font-semibold">
            <tr>
              <th class="px-5 py-3.5">Instituição & Porte</th>
              <th class="px-5 py-3.5">Contato do Decisor</th>
              <th class="px-5 py-3.5">Desafio / Mensagem</th>
              <th class="px-5 py-3.5">Data / Hora</th>
              <th class="px-5 py-3.5">Status</th>
              <th class="px-5 py-3.5 text-right">Ação Direta</th>
            </tr>
          </thead>
          <tbody id="leads-table-body" class="divide-y divide-slate-800/60">
            <!-- Renderizado dinamicamente via Script -->
          </tbody>
        </table>
      </div>

      <!-- Estado Vazio -->
      <div id="empty-state" class="hidden py-16 text-center">
        <svg class="mx-auto h-12 w-12 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="mt-4 text-sm font-medium text-slate-400">Nenhum lead encontrado para este filtro.</p>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ initialLeads }}>
  let allLeads = initialLeads || [];
  let currentFilter = 'all';
  let searchTerm = '';

  const tableBody = document.getElementById('leads-table-body');
  const emptyState = document.getElementById('empty-state');
  const searchInput = document.getElementById('search-input');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const btnRefresh = document.getElementById('btn-refresh');
  const btnExportCsv = document.getElementById('btn-export-csv');
  const btnToggleSql = document.getElementById('btn-toggle-sql');
  const sqlBox = document.getElementById('sql-box');
  const btnCopySql = document.getElementById('btn-copy-sql');

  // Mesclar leads salvos em localStorage caso existam
  function loadAndMergeLocalLeads() {
    try {
      const local = JSON.parse(localStorage.getItem('saascore_leads') || '[]');
      if (Array.isArray(local) && local.length > 0) {
        // Evita duplicatas por e-mail ou data
        local.forEach((localLead) => {
          if (!allLeads.some((l) => l.email === localLead.email && l.institution === localLead.institution)) {
            allLeads.unshift(localLead);
          }
        });
      }
    } catch (_) {}
  }

  function formatPorte(porte) {
    switch (porte) {
      case 'ate-100':
        return { label: 'Até 100 ativos', class: 'bg-slate-800 text-slate-300' };
      case '101-500':
        return { label: '101 a 500 ativos', class: 'bg-blue-500/20 text-blue-300 border border-blue-500/30' };
      case '501-1500':
        return { label: '501 a 1.500 ativos', class: 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' };
      case 'acima-1500':
        return { label: '+1.500 ativos (Rede)', class: 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' };
      default:
        return { label: porte || 'Não informado', class: 'bg-slate-800 text-slate-300' };
    }
  }

  function formatDate(isoStr) {
    if (!isoStr) return '-';
    const d = new Date(isoStr);
    return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }) +
      ' às ' +
      d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  function cleanPhoneForWhatsApp(phone) {
    if (!phone) return '';
    const digits = phone.replace(/\D/g, '');
    if (digits.length <= 11) return '55' + digits;
    return digits;
  }

  function updateMetrics() {
    document.getElementById('metric-total').textContent = allLeads.length.toString();
    document.getElementById('metric-novos').textContent = allLeads.filter((l) => l.status === 'novo').length.toString();
    document.getElementById('metric-agendados').textContent = allLeads.filter((l) => l.status === 'agendado').length.toString();
    document.getElementById('metric-enterprise').textContent = allLeads.filter((l) => l.park_size === '501-1500' || l.park_size === 'acima-1500').length.toString();
  }

  function renderTable() {
    const filtered = allLeads.filter((lead) => {
      const matchesFilter = currentFilter === 'all' || lead.status === currentFilter;
      const term = searchTerm.toLowerCase();
      const matchesSearch =
        !term ||
        lead.institution?.toLowerCase().includes(term) ||
        lead.name?.toLowerCase().includes(term) ||
        lead.email?.toLowerCase().includes(term) ||
        lead.phone?.includes(term);

      return matchesFilter && matchesSearch;
    });

    if (filtered.length === 0) {
      tableBody.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    tableBody.innerHTML = filtered
      .map((lead) => {
        const porteInfo = formatPorte(lead.park_size);
        const waNumber = cleanPhoneForWhatsApp(lead.phone);
        const waText = encodeURIComponent(
          `Olá ${lead.name}, tudo bem? Sou da equipe da SaaSCore Sistemas. Recebemos seu contato referente ao ${lead.institution} e gostaria de apresentar a demonstração do SGEMH.`
        );

        return `
          <tr class="hover:bg-slate-900/50 transition">
            <td class="px-5 py-4">
              <div class="font-bold text-white text-sm">${lead.institution}</div>
              <div class="mt-1 inline-block rounded px-2 py-0.5 text-[10px] font-semibold ${porteInfo.class}">
                ${porteInfo.label}
              </div>
            </td>

            <td class="px-5 py-4">
              <div class="font-semibold text-slate-200">${lead.name}</div>
              <div class="text-[11px] text-cyan-400 font-mono mt-0.5">${lead.email}</div>
              <div class="text-[11px] text-slate-400 mt-0.5">${lead.phone}</div>
            </td>

            <td class="px-5 py-4 max-w-xs">
              <p class="text-slate-300 text-[11px] leading-relaxed line-clamp-2" title="${lead.message || 'Sem mensagem'}">
                ${lead.message || '<span class="text-slate-500 italic">Nenhuma observação informada</span>'}
              </p>
            </td>

            <td class="px-5 py-4 whitespace-nowrap text-[11px] text-slate-400">
              ${formatDate(lead.createdAt)}
            </td>

            <td class="px-5 py-4 whitespace-nowrap">
              <select
                data-lead-id="${lead.id}"
                class="status-select rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1 text-xs font-semibold transition focus:outline-none focus:ring-1 focus:ring-cyan-500 ${
                  lead.status === 'novo' ? 'text-cyan-400 border-cyan-500/40' :
                  lead.status === 'agendado' ? 'text-blue-400 border-blue-500/40' :
                  lead.status === 'convertido' ? 'text-emerald-400 border-emerald-500/40' :
                  lead.status === 'em_contato' ? 'text-amber-400 border-amber-500/40' : 'text-slate-400'
                }"
              >
                <option value="novo" ${lead.status === 'novo' ? 'selected' : ''}>Novo Lead</option>
                <option value="em_contato" ${lead.status === 'em_contato' ? 'selected' : ''}>Em Contato</option>
                <option value="agendado" ${lead.status === 'agendado' ? 'selected' : ''}>Demostração Agendada</option>
                <option value="convertido" ${lead.status === 'convertido' ? 'selected' : ''}>Convertido</option>
                <option value="arquivado" ${lead.status === 'arquivado' ? 'selected' : ''}>Arquivado</option>
              </select>
            </td>

            <td class="px-5 py-4 whitespace-nowrap text-right">
              <div class="flex items-center justify-end gap-2">
                <a
                  href="https://wa.me/${waNumber}?text=${waText}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 p-1.5 text-emerald-400 hover:bg-emerald-500 hover:text-slate-950 transition"
                  title="Chamar no WhatsApp"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.668-2.65-2.316-2.73-2.423-.081-.107-.655-.873-.655-1.662 0-.788.414-1.177.562-1.339.148-.162.324-.202.432-.202.108 0 .216.002.311.007.1.005.234-.038.366.279.135.324.46 1.121.5 1.202.04.081.067.175.014.283-.054.108-.081.175-.162.27-.081.095-.171.212-.244.285-.081.081-.166.169-.071.332.095.163.42 693.901 1.121.618.549 1.139.719 1.302.8.162.081.256.068.351-.041.095-.108.405-.472.513-.635.108-.162.216-.135.365-.081.148.054.945.446 1.107.527.162.081.27.122.311.189.04.067.04.391-.104.796z"/>
                  </svg>
                </a>
                <a
                  href="mailto:${lead.email}?subject=Demonstração%20SGEMH%20-%20SaaSCore%20Sistemas"
                  class="rounded-lg bg-blue-500/10 border border-blue-500/30 p-1.5 text-blue-400 hover:bg-blue-500 hover:text-white transition"
                  title="Enviar E-mail"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </a>
              </div>
            </td>
          </tr>
        `;
      })
      .join('');

    // Listener para alteração de status
    document.querySelectorAll('.status-select').forEach((select) => {
      select.addEventListener('change', async (e) => {
        const target = e.target;
        const leadId = target.getAttribute('data-lead-id');
        const newStatus = target.value;

        try {
          await fetch('/api/leads', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: leadId, status: newStatus }),
          });

          const lead = allLeads.find((l) => l.id === leadId);
          if (lead) lead.status = newStatus;
          updateMetrics();
        } catch (err) {
          console.error('Falha ao atualizar status', err);
        }
      });
    });
  }

  // Event Listeners
  searchInput?.addEventListener('input', (e) => {
    searchTerm = e.target.value;
    renderTable();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-cyan-500', 'text-slate-950');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      btn.classList.add('active', 'bg-cyan-500', 'text-slate-950');
      btn.classList.remove('bg-slate-800', 'text-slate-300');

      currentFilter = btn.getAttribute('data-filter') || 'all';
      renderTable();
    });
  });

  btnRefresh?.addEventListener('click', async () => {
    try {
      const res = await fetch('/api/leads');
      const data = await res.json();
      if (data?.leads) {
        allLeads = data.leads;
        loadAndMergeLocalLeads();
        updateMetrics();
        renderTable();
      }
    } catch (_) {}
  });

  btnExportCsv?.addEventListener('click', () => {
    const headers = ['ID', 'Data', 'Instituicao', 'Nome', 'Email', 'Telefone', 'Porte', 'Status', 'Mensagem'];
    const rows = allLeads.map((l) => [
      l.id,
      l.createdAt,
      `"${l.institution || ''}"`,
      `"${l.name || ''}"`,
      `"${l.email || ''}"`,
      `"${l.phone || ''}"`,
      `"${l.park_size || ''}"`,
      `"${l.status || ''}"`,
      `"${(l.message || '').replace(/"/g, '""')}"`,
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(';'), ...rows.map((e) => e.join(';'))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `leads_saascore_sgemh_${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  btnToggleSql?.addEventListener('click', () => {
    sqlBox.classList.toggle('hidden');
  });

  btnCopySql?.addEventListener('click', () => {
    const code = document.getElementById('sql-code').textContent;
    navigator.clipboard.writeText(code).then(() => {
      btnCopySql.textContent = 'Copiado!';
      setTimeout(() => (btnCopySql.textContent = 'Copiar SQL'), 2000);
    });
  });

  // Inicialização
  loadAndMergeLocalLeads();
  updateMetrics();
  renderTable();
</script>
